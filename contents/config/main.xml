<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- ── Existing keys — do NOT rename or reorder ───────────────────── -->
        <entry name="taskText" type="String">
            <default></default>
        </entry>
        <entry name="barColor" type="Color">
            <default>#2ecc71</default>
        </entry>
        <entry name="fontFamily" type="String">
            <default></default>
        </entry>
        <entry name="fontColor" type="Color">
            <default>transparent</default>
        </entry>
        <entry name="timerFontFamily" type="String">
            <default></default>
        </entry>
        <entry name="placeholderText" type="String">
            <default></default>
        </entry>
        <entry name="showTimer" type="Bool">
            <default>true</default>
        </entry>
        <entry name="taskStartedAt" type="String">
            <default></default>
        </entry>
        <entry name="blinkEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="blinkIntervalMinutes" type="Int">
            <default>3</default>
        </entry>
        <entry name="blinkColor" type="Color">
            <default>#32CD32</default>
        </entry>
        <entry name="pomodoroEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="pomodoroMinutes" type="Int">
            <default>20</default>
        </entry>
        <entry name="restMinutes" type="Int">
            <default>5</default>
        </entry>
        <entry name="restColor" type="Color">
            <default>#95a5a6</default>
        </entry>
        <entry name="pomodoroPhase" type="String">
            <default></default>
        </entry>
        <entry name="phaseEndsAt" type="String">
            <default></default>
        </entry>
        <entry name="pomodoroCount" type="Int">
            <default>0</default>
        </entry>

        <!-- ── AckBar+ new keys ───────────────────────────────────────────── -->

        <!-- History tracking master switch -->
        <entry name="enableHistory" type="Bool">
            <default>true</default>
        </entry>
        <!-- Track completed Pomodoros in history -->
        <entry name="trackPomodoros" type="Bool">
            <default>true</default>
        </entry>
        <!-- Track task names alongside Pomodoro records -->
        <entry name="trackTasks" type="Bool">
            <default>true</default>
        </entry>
        <!-- Show daily statistics panel in the history view -->
        <entry name="showDailyStats" type="Bool">
            <default>true</default>
        </entry>
        <!-- Enable notification sounds -->
        <entry name="enableNotificationSound" type="Bool">
            <default>false</default>
        </entry>
        <!-- Play sound when a work Pomodoro finishes -->
        <entry name="soundOnPomodoroComplete" type="Bool">
            <default>true</default>
        </entry>
        <!-- Play sound when a break finishes -->
        <entry name="soundOnBreakComplete" type="Bool">
            <default>true</default>
        </entry>
        <!-- Dedup guard: id of the last Pomodoro record that was persisted -->
        <entry name="lastRecordedPomodoroId" type="String">
            <default></default>
        </entry>
        <!-- Timestamp (ms) when the current work/rest phase started — for duration calc -->
        <entry name="phaseStartedAt" type="String">
            <default></default>
        </entry>
        <!-- Serialized history: JSON string containing the full history array.
             Format: {"version":1,"records":[{id,task,startedAt,endedAt,durationSeconds,pomodorosCompleted,type},...]}
             Stored as a KConfig String to avoid requiring an external file API.
             The empty default triggers graceful initialization to an empty array. -->
        <entry name="historyJson" type="String">
            <default></default>
        </entry>
    </group>
</kcfg>
